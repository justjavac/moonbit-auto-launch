name = "justjavac/auto_launch"

version = "0.1.6"

readme = "README.md"

repository = "https://github.com/justjavac/moonbit-auto-launch"

license = "MIT"

keywords = [
  "desktop",
  "autostart",
  "startup",
  "auto-launch",
  "native",
  "windows",
  "macos",
  "linux",
]

description = "Cross-platform auto-launch helpers for MoonBit, inspired by Teamwork/node-auto-launch."

warnings = ""

preferred_target = "native"

supported_targets = "+native"

options(
  source: "src",
)